## 13. Frontend Hook Skeleton

```ts
export function useChatHydration(chatId: string, characterId: string, opts?: { includeCredits?: boolean }) {
  return useQuery({
    queryKey: ['chat','hydrate', chatId],
    queryFn: async () => {
      const { data: { session } } = await supabase.auth.getSession();
      const resp = await fetch(`${import.meta.env.VITE_SUPABASE_FUNCTIONS_URL}/chat-management`, {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${session?.access_token}`,
          'Content-Type': 'application/json',
          apikey: import.meta.env.VITE_SUPABASE_ANON_KEY
        },
        body: JSON.stringify({
          operation: 'hydrate-chat',
          chatId,
          characterId,
          includeCredits: opts?.includeCredits
        })
      });
      if (!resp.ok) throw new Error(await resp.text());
      return resp.json();
    },
    staleTime: 60_000
  });
}
```

