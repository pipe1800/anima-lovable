## 12. Example Edge Function Add (Skeleton)

(Integrate into `chat-management` dispatcher)
```ts
// case 'hydrate-chat': return await handleHydrateChat(payload, user, supabase, supabaseAdmin);
```

```ts
export async function handleHydrateChat(req, user, supabase, admin) {
  const { chatId, characterId, includeCredits = false, selectedPersonaId } = req;
  const [
    messages,
    context,
    character,
    persona,
    userCharSettings,
    globalSettings,
    latestSummary,
    credits
  ] = await Promise.all([
    fetchConversationHistory(chatId, supabase, 30),
    fetchCurrentContext(user.id, chatId, characterId, supabase),
    supabase.from('characters').select('id,name,avatar_url,short_description').eq('id', characterId).single(),
    selectedPersonaId 
      ? supabase.from('personas').select('id,name,bio,lore').eq('id', selectedPersonaId).maybeSingle()
      : Promise.resolve({ data: null }),
    supabase.from('user_character_settings').select('*').eq('user_id', user.id).eq('character_id', characterId).maybeSingle(),
    admin.from('user_global_chat_settings').select('*').eq('user_id', user.id).maybeSingle(),
    supabase.from('character_memories')
      .select('id,message_count,created_at')
      .eq('chat_id', chatId)
      .eq('is_auto_summary', true)
      .order('created_at', { ascending: false })
      .limit(1),
    includeCredits
      ? supabase.rpc('get_user_credits', { p_user_id: user.id })
      : Promise.resolve({ data: null })
  ]);

  return {
    success: true,
    chatId,
    recentMessages: messages,
    character: character.data,
    persona: persona.data,
    settings: {
      character: userCharSettings.data || {},
      global: globalSettings.data || {}
    },
    context,
    latestSummary: latestSummary.data?.[0] || null,
    credits: credits?.data ?? null
  };
}
```

